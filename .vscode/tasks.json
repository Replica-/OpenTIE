{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OpenTIE (Debug)",
      "type": "shell",
      "command": "C:/msys64/usr/bin/bash.exe",
      "args": ["-lc", "export MSYSTEM=UCRT64; source /etc/profile; bash /d/development/OpenTIE-deps/build-tie.sh Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build OpenTIE (Release)",
      "type": "shell",
      "command": "C:/msys64/usr/bin/bash.exe",
      "args": ["-lc", "export MSYSTEM=UCRT64; source /etc/profile; bash /d/development/OpenTIE-deps/build-tie.sh Release"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
